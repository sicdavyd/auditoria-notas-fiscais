@startuml er_diagram
title Diagrama Entidade-Relacionamento - Mapeamento ORM (SQLAlchemy)

skinparam linetype ortho

entity "categoria" as categoria {
  * id_categoria : INTEGER <<PK>>
  --
  nome_categoria : VARCHAR
  departamento : VARCHAR
}

entity "produto" as produto {
  * id_produto : INTEGER <<PK>>
  --
  nome : VARCHAR
  preco_unitario : DECIMAL
  quantidade_estoque : INTEGER
  id_categoria : INTEGER <<FK>>
}

entity "detalhe_produto" as detalhe {
  * id_detalhe : INTEGER <<PK>>
  --
  id_produto : INTEGER <<FK, UNIQUE>>
  peso_kg : DECIMAL
  dimensoes_cm : VARCHAR
  garantia_meses : INTEGER
}

entity "pedido" as pedido {
  * id_pedido : INTEGER <<PK>>
  --
  data_pedido : DATE
  status_pedido : VARCHAR
}

entity "item_pedido" as item_pedido {
  * id_item_pedido : INTEGER <<PK>>
  --
  id_produto : INTEGER <<FK>>
  id_pedido : INTEGER <<FK>>
  quantidade : INTEGER
  preco_aplicado : DECIMAL
}

' ---- Cardinalidades ----
categoria ||--o{ produto : "1 : N\n(id_categoria)"
produto ||--|| detalhe : "1 : 1\n(id_produto UNIQUE)"
produto ||--o{ item_pedido : "1 : N"
pedido ||--o{ item_pedido : "1 : N"

note bottom of item_pedido
  Tabela associativa que resolve
  o relacionamento N:M entre
  produto e pedido.
end note

@enduml
